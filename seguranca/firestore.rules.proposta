// PROPOSTA — NAO ATIVAR SEM TESTE EM EMULADOR E CUSTOM CLAIM admin.
// Este arquivo nao e o firebase/firestore.rules ativo.
// Passos de ativacao: atribuir custom claim admin ao UID do proprietario por Admin SDK,
// renovar token, testar CRUD admin/aluno, fazer backup e publicar as regras.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logged() { return request.auth != null; }
    function owner(uid) { return logged() && request.auth.uid == uid; }
    function admin() { return logged() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, write: if owner(uid);
      match /{path=**} { allow read, write: if owner(uid); }
    }
    match /contests/{id} { allow read: if logged(); allow write: if admin(); }
    match /topics/{id} { allow read: if logged(); allow write: if admin(); }
    match /materials/{id} { allow read: if logged(); allow write: if admin(); }
    match /questions/{id} { allow read: if logged(); allow write: if admin(); }
    match /content_blocks/{id} { allow read: if logged(); allow write: if admin(); }
    match /content_nodes/{id} { allow read: if logged(); allow write: if admin(); }
    match /laws/{id} { allow read: if logged(); allow write: if admin(); }
    match /law_documents/{id} { allow read: if logged(); allow write: if admin(); }
    match /contest_versions/{id} { allow read: if logged(); allow write: if admin(); }
    match /edital_items/{id} { allow read: if logged(); allow write: if admin(); }
  }
}
